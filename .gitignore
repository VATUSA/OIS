# Rust
/target
**/target

# Node
node_modules
.pnpm-store
.turbo
.next
dist

# Tauri
desktop/src-tauri/target
# Generated capability/permission schemas (regenerated by tauri-build)
desktop/src-tauri/gen

# Env / secrets
.env
.env.local
*.local
# Prometheus' copy of METRICS_TOKEN — the deploy docs tell you to create this; it is a credential.
deploy/observability/metrics_token

# OS / editor
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Claude Code — ignore personal/ephemeral state, but SHARE the team workflow
# (slash commands, helper scripts, rules, agents, hooks, and the hook config).
# settings.local.json, review markers/, and the vendored skills/ stay ignored.
.claude/*
!.claude/commands/
!.claude/scripts/
!.claude/rules/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
