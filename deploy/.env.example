# Copy to deploy/.env and fill in, then:
#   docker compose -f deploy/docker-compose.yml up -d
# One file per environment (dev / staging / prod) — differ by PUBLIC_URL, IMAGE_TAG, secrets.

# --- images (from .github/workflows/build-images.yml) ---
REGISTRY=ghcr.io
IMAGE_REPO=your-org/ois          # → ghcr.io/your-org/ois-backend and -web
IMAGE_TAG=latest                 # or a git sha / vX.Y.Z tag to pin a release

# --- public origin + web port ---
PUBLIC_URL=https://ois.example.com   # the public HTTPS origin users hit
WEB_PORT=8080                        # host port the web container listens on (front with TLS)

# --- database ---
POSTGRES_USER=ois
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ois

# --- auth / cookies ---
COOKIE_SECURE=1
OIS_SERVER_ADMIN_CID=            # comma-separated VATSIM CIDs that get SERVER_ADMIN

# --- VATSIM Connect OAuth (required for sign-in) ---
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=

# --- VATUSA sync (optional; blank disables) ---
VATUSA_API_KEY=
