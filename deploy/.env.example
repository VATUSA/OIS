# Copy to deploy/.env and fill in, then:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# One file per environment (dev / staging / prod) — differ by origins, IMAGE_TAG, secrets.

# --- images (built by .github/workflows/build-images.yml) ---
REGISTRY=ghcr.io
IMAGE_REPO=vatusa/ois            # → ghcr.io/vatusa/ois-backend and ghcr.io/vatusa/ois-web
IMAGE_TAG=latest                 # or a git sha / vX.Y.Z to pin a release

# Port bind address. 127.0.0.1 = host-only (front it with Caddy). 0.0.0.0 = reachable on the
# host's LAN IP directly (e.g. http://10.35.1.6:${WEB_PORT}).
BIND_HOST=127.0.0.1

# --- public origins (Caddy terminates TLS for these) ---
WEB_ORIGIN=https://ois.vzdc.org
API_ORIGIN=https://api-ois.vzdc.org

# --- host ports Caddy proxies to (loopback) ---
WEB_PORT=8080                    # -> ois.vzdc.org
API_PORT=3000                    # -> api-ois.vzdc.org

# --- database ---
POSTGRES_USER=ois
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ois

# --- auth ---
OIS_SERVER_ADMIN_CID=            # comma-separated VATSIM CIDs granted SERVER_ADMIN
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=

# --- VATUSA sync (optional; blank disables) ---
VATUSA_API_KEY=
