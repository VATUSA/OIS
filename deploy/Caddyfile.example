# Example Caddy config for the two-domain deployment. Caddy auto-provisions TLS and forwards
# Host + X-Forwarded-* by default, which is what the backend expects. Point each domain at the
# loopback port the compose stack publishes (API_PORT / WEB_PORT in deploy/.env).

api-ois.vzdc.org {
	reverse_proxy 127.0.0.1:3000
}

ois.vzdc.org {
	reverse_proxy 127.0.0.1:8080
}

docs.ois.vzdc.org {
	reverse_proxy 127.0.0.1:8081
}
