# ============================================================================================
# OIS configuration — the single source of truth. Copy to .env and fill in.
# The same docker-compose.yml runs every environment; only these values differ between them.
#
#   Dev, hot reload:      docker compose up -d postgres    then  just backend / just web
#   Dev, full container:  docker compose up --build
#   Prod:                 docker compose pull && docker compose up -d
# ============================================================================================

# --- deployment (docker compose) ---
# Images are built + pushed by .github/workflows/build-images.yml.
REGISTRY=ghcr.io
IMAGE_REPO=vatusa/ois            # -> ghcr.io/vatusa/ois-backend | -web | -docs
IMAGE_TAG=latest                 # or a git sha / vX.Y.Z to pin a release
# 127.0.0.1 = ports are host-local (front them with your reverse proxy).
# 0.0.0.0    = reachable directly on the host's LAN IP.
BIND_HOST=127.0.0.1
API_PORT=3000                    # host port -> backend   (api.<domain>)
WEB_PORT=8080                    # host port -> web SPA    (<domain>)
DOCS_PORT=8081                   # host port -> docs       (docs.<domain>)
DB_PORT=5432                     # host port -> postgres   (native dev connects here)

# --- postgres ---
POSTGRES_USER=ois
POSTGRES_PASSWORD=ois            # CHANGE in prod
POSTGRES_DB=ois

# --- backend ---
# A native `cargo run` uses this DATABASE_URL; the compose backend overrides the host to reach
# the postgres service in-network, so keep 127.0.0.1 here for local runs.
DATABASE_URL=postgres://ois:ois@127.0.0.1:5432/ois
BIND_ADDR=127.0.0.1:3000         # native bind; compose overrides to 0.0.0.0:3000 in-container
# false for plain-HTTP dev; true behind TLS (otherwise the session cookie is dropped on login).
COOKIE_SECURE=false
# Bootstraps server admins (comma-separated VATSIM CIDs). Only way to grant SERVER_ADMIN.
OIS_SERVER_ADMIN_CID=

# --- VATSIM OAuth ---
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=
# Must exactly match the callback route AND the URL registered in the VATSIM client.
VATSIM_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/vatsim/callback
# Dev hosts (auth-dev.vatsim.net) + POST client auth for local development.
VATSIM_DEV_MODE=true
VATSIM_CLIENT_AUTH_METHOD=post
# Browser origin(s) allowed for CORS + OAuth return_to (comma-separated) = the web app origin,
# plus the desktop app's. The Tauri webview has its own origin rather than an http host — it is
# `tauri://localhost` on macOS/Linux and `http://tauri.localhost` on Windows — so a deployment that
# omits these serves the desktop app a page whose every API call is then blocked by CORS.
#
# This list is ONE trust boundary, not two: it is also the allowlist `validate_return_to` checks
# OAuth `return_to` targets against. So entries here widen the post-login redirect surface as well —
# `http://tauri.localhost` becomes a valid redirect target for ordinary browser logins, which is
# tolerable only because it resolves to the user's own loopback. Drop the desktop entries on any
# deployment that will not serve a desktop app. Note `tauri://localhost` is accepted for CORS but
# rejected for `return_to` (that check requires an http/https scheme) — #346 has to resolve that
# before an OAuth flow can return into the webview.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# --- VATUSA ---
# Base URL (default https://api.vatusa.net). A ZHQ/division API key enables member sync on
# sign-in + reconciliation; webhook registration additionally needs OIS_PUBLIC_URL.
VATUSA_API_BASE=
VATUSA_API_KEY=
# This deployment's public HTTPS origin, used to register the VATUSA roster-change webhook
# receiver (e.g. https://api.ois.vzdc.org). Leave unset to skip webhook registration.
OIS_PUBLIC_URL=

# --- web container (runtime-injected into /config.js at container start) ---
# The API + docs origins the built SPA points at. Empty API = same-origin; empty docs = no link.
# Prod e.g. OIS_API_URL=https://api.ois.vzdc.org  DOCS_URL=https://docs.ois.vzdc.org
OIS_API_URL=
DOCS_URL=

# --- web dev (Vite; put these in web/.env.local for the native `just web` dev server) ---
VITE_OIS_API_URL=http://127.0.0.1:3000
VITE_OIS_DOCS_URL=http://localhost:5174
# Override for `pnpm --filter @ois/api-client codegen` if the backend isn't on the default host.
OIS_OPENAPI_URL=http://127.0.0.1:3000/docs/api/v1/openapi.json

# --- discord bot (native `just bot`, or `docker compose --profile discord up -d`) ---
# The only vars discord/src/config.rs::from_env reads. Compose overrides OIS_API_BASE to reach
# the backend over the compose network (http://backend:3000) instead of this host-local default.
DISCORD_BOT_TOKEN=
OIS_API_BASE=http://127.0.0.1:3000
# Service-account token (an `ois_sa_…` key holding the BOT role) the bot authenticates with.
OIS_API_TOKEN=
OIS_POLL_SECS=5
