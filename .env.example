# --- backend ---
DATABASE_URL=postgres://ois:ois@127.0.0.1:5432/ois
BIND_ADDR=127.0.0.1:3000
COOKIE_SECURE=false

# Bootstraps server admins (comma-separated VATSIM CIDs). Only way to grant SERVER_ADMIN.
OIS_SERVER_ADMIN_CID=

# --- VATSIM OAuth ---
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=
# Must exactly match the callback route AND the URL registered in the VATSIM client.
VATSIM_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/vatsim/callback
# Use dev hosts (auth-dev.vatsim.net) + POST client auth for local development.
VATSIM_DEV_MODE=true
VATSIM_CLIENT_AUTH_METHOD=post
# Origins allowed for CORS + OAuth return_to (comma-separated). Must be the WEB app origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# --- VATUSA ---
VATUSA_API_BASE=
VATUSA_API_KEY=

# --- web (Vite; typically in web/.env.local) ---
VITE_OIS_API_URL=http://127.0.0.1:3000
# Override for `pnpm --filter @ois/api-client codegen` if the backend isn't on the default host:
OIS_OPENAPI_URL=http://127.0.0.1:3000/docs/api/v1/openapi.json

# --- discord bot ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Bot authenticates to the backend as a service account:
OIS_API_BASE=http://127.0.0.1:3000
OIS_SERVICE_ACCOUNT_TOKEN=
