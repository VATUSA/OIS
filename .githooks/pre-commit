#!/usr/bin/env bash
# Git pre-commit hook, installed for the whole clone by `just setup` (core.hooksPath=.githooks).
# core.hooksPath is relative, so each worktree runs its own copy of this wrapper. The checks
# live in bin/pre-commit, looked for the way bin/pre-push looks for its helpers: in this file's
# checkout, then the checkout being committed or pushed, then the main checkout. Git's
# stdin and arguments pass through.
for hook in \
    "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/bin/pre-commit" \
    "$(git rev-parse --show-toplevel 2>/dev/null)/bin/pre-commit" \
    "$(cd "$(git rev-parse --git-common-dir 2>/dev/null)/.." 2>/dev/null && pwd)/bin/pre-commit"; do
    [[ -f "$hook" ]] && exec bash "$hook" "$@"
done
echo "pre-commit: bin/pre-commit not found in this checkout or the main one (git merge origin/next)." >&2
exit 1
