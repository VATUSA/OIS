root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,md}]
indent_size = 2

# SQL migrations are hand-formatted and carry a `-- @formatter:off` guard; do not
# let the IDE reformat them (it collapses them to one token per line).
[*.sql]
indent_size = 4
